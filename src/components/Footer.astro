---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import logo from '../assets/photos/logo.png';
import { business, formatHoursLabel } from '../data/business';

const year = business.foundedYear;
---

<footer class="border-t border-ink/10 bg-ink text-cream">
  <div class="mx-auto max-w-(--container-page) px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <a href="/" class="flex items-center gap-3">
          <Image src={logo} alt="Miguel's Mexican Dining logo" width={48} height={48} class="h-12 w-12 rounded-full bg-cream p-1" />
          <span class="font-display text-xl font-semibold text-cream">Miguel's</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-cream/70">
          Family-owned Mexican cocina in Stockton, California — serving scratch-made plates since {year}.
        </p>
        <div class="mt-5 flex items-center gap-4">
          {
            business.social.facebook && (
              <a
                href={business.social.facebook}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Miguel's on Facebook"
                class="text-cream/70 transition-colors hover:text-marigold"
              >
                <Icon name="lucide:facebook" class="h-5 w-5" aria-hidden="true" />
              </a>
            )
          }
        </div>
      </div>

      <div>
        <h2 class="font-display text-sm font-semibold uppercase tracking-[0.15em] text-marigold">Visit</h2>
        <address class="mt-4 space-y-1 text-sm not-italic leading-relaxed text-cream/80">
          <p>{business.address.street}</p>
          <p>{business.address.city}, {business.address.state} {business.address.zip}</p>
        </address>
        <a href={business.mapsUrl} target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-marigold hover:underline">
          Get Directions
          <Icon name="lucide:arrow-up-right" class="h-3.5 w-3.5" aria-hidden="true" />
        </a>
        <p class="mt-4">
          <a href={`tel:${business.phone.e164}`} class="text-sm font-medium text-cream/90 hover:text-marigold">
            {business.phone.display}
          </a>
        </p>
      </div>

      <div>
        <h2 class="font-display text-sm font-semibold uppercase tracking-[0.15em] text-marigold">Hours</h2>
        <ul class="mt-4 space-y-1.5 text-sm text-cream/80">
          {
            business.hours.map((h) => (
              <li class="flex justify-between gap-6">
                <span>{h.day}</span>
                <span class="text-cream/60">{formatHoursLabel(h)}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="font-display text-sm font-semibold uppercase tracking-[0.15em] text-marigold">Explore</h2>
        <ul class="mt-4 space-y-2 text-sm text-cream/80">
          <li><a href="/menu" class="hover:text-marigold">Full Menu</a></li>
          <li><a href="/about" class="hover:text-marigold">Our Story</a></li>
          <li><a href="/gallery" class="hover:text-marigold">Gallery</a></li>
          <li><a href="/contact" class="hover:text-marigold">Contact & Location</a></li>
          <li>
            <a href={business.orderOnlineUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-marigold hover:underline">
              Order Online
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-2 border-t border-cream/10 pt-6 text-xs text-cream/50 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {new Date().getFullYear()} {business.name}. All rights reserved.</p>
      <p>{business.address.city}, {business.address.state} &middot; Family-owned since {year}</p>
    </div>
  </div>
</footer>

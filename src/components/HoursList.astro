---
import { business, formatHoursLabel } from '../data/business';

interface Props {
  class?: string;
  tone?: 'ink' | 'cream';
}

const { class: className = '', tone = 'ink' } = Astro.props;

// Astro.locals doesn't give us request time reliably for static builds, so
// "today" highlighting runs client-side via data attributes below.
const rowToneClass = tone === 'cream' ? 'text-cream/80' : 'text-ink/75';
---

<ul class:list={['divide-y divide-ink/10', className]} data-hours-list>
  {
    business.hours.map((h) => (
      <li class:list={['flex items-center justify-between gap-6 py-2.5 text-sm', rowToneClass]} data-day={h.day}>
        <span class="font-medium">{h.day}</span>
        <span>{formatHoursLabel(h)}</span>
      </li>
    ))
  }
</ul>

<script>
  const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  const today = days[new Date().getDay()];
  document.querySelectorAll<HTMLElement>('[data-hours-list] [data-day]').forEach((row) => {
    if (row.dataset.day === today) {
      row.classList.add('font-semibold', 'text-chile');
    }
  });
</script>
